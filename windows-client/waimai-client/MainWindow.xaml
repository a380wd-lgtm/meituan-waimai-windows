<Window x:Class="MeituanWaimaiClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="美团外卖 - 1:1 原生手机版 (v8.84.2 Build 91293)"
        Width="420"
        Height="910"
        MinWidth="420"
        MaxWidth="420"
        MinHeight="910"
        MaxHeight="910"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="MtYellowBrush" Color="#FFD100" />
        <SolidColorBrush x:Key="MtAmberBrush" Color="#FFC300" />
        <SolidColorBrush x:Key="MtOrangeRedBrush" Color="#FF4A26" />
        <SolidColorBrush x:Key="MtDarkInkBrush" Color="#222426" />
        <SolidColorBrush x:Key="MtSubTextBrush" Color="#66686B" />
        <SolidColorBrush x:Key="MtMutedBrush" Color="#999B9E" />
        <SolidColorBrush x:Key="MtBorderBrush" Color="#ECEEF2" />

        <LinearGradientBrush x:Key="MtHeaderGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFD000" Offset="0.0" />
            <GradientStop Color="#FFBD00" Offset="0.75" />
            <GradientStop Color="#F4F5F7" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MtGoldBtnGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFDF2B" Offset="0.0" />
            <GradientStop Color="#FFC300" Offset="1.0" />
        </LinearGradientBrush>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#EFEFEF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FlatActionBtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#FFD100" />
            <Setter Property="Foreground" Value="#222426" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostPillBtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#333537" />
            <Setter Property="BorderBrush" Value="#E2E4E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF9DC" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFC300" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 原生手机竖屏总视口 (412×892 dp 标准全面屏比例) -->
    <Grid x:Name="RootViewportGrid" Background="#F4F5F7">
        <Grid.RowDefinitions>
            <!-- Row 0: Android 沉浸式顶部状态栏 (26px) -->
            <RowDefinition Height="26" />
            <!-- Row 1: 主内容与全屏压栈页面层 (*) -->
            <RowDefinition Height="*" />
            <!-- Row 2: 底部实时状态轻量提示条 (22px) -->
            <RowDefinition Height="22" />
            <!-- Row 3: 底部 5-Tab 原生导航栏 (58px) -->
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <!-- ==================== Row 0: Android 原生状态栏 ==================== -->
        <Border Grid.Row="0" Background="#FFD000" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="18:30" FontSize="11.5" FontWeight="Bold" Foreground="#222426" Margin="0,0,8,0" />
                    <TextBlock Text="美团外卖 · Android 1:1" FontSize="10.5" Foreground="#443800" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="5G" FontSize="10.5" FontWeight="Bold" Foreground="#222426" Margin="0,0,6,0" />
                    <TextBlock Text="Wi-Fi" FontSize="10.5" FontWeight="SemiBold" Foreground="#222426" Margin="0,0,6,0" />
                    <Border Background="#222426" CornerRadius="3" Padding="4,1">
                        <TextBlock Text="100%" FontSize="9.5" FontWeight="Bold" Foreground="#FFD100" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Row 1: 核心视图区 (含一级 5-Tab 层 + 二级全屏压栈层 + 三级弹窗层) ==================== -->
        <Grid Grid.Row="1">

            <!-- ========================================================================= -->
            <!-- 第一层：一级 5-Tab 根视图层 (当 ActiveFullScreenPage == "None" 时显示)      -->
            <!-- ========================================================================= -->
            <Grid Visibility="{Binding IsRootTabLayerVisible, Converter={StaticResource BoolToVis}}">

                <!-- ==================== Tab 1: 首页外卖 (WMHomePageFragment) ==================== -->
                <Grid Visibility="{Binding IsHomeTabActive, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 首页美团黄沉浸式顶栏：定位地址 + 消息铃铛 + 登录胶囊 + 搜索框 + 热搜词 -->
                    <Border Grid.Row="0" Background="{StaticResource MtHeaderGradient}" Padding="12,6,12,8">
                        <StackPanel>
                            <!-- 第一行：收货地址 + 消息中心 + 登录状态胶囊 -->
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding OpenFullScreenPageCommand}"
                                        CommandParameter="AddressManager"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📍" FontSize="14" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentAddressDisplayText}"
                                                   FontSize="13.5"
                                                   FontWeight="Bold"
                                                   Foreground="#222426"
                                                   MaxWidth="195"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text=" ▾" FontSize="11" FontWeight="Bold" Foreground="#222426" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 消息中心铃铛按钮 -->
                                <Button Grid.Column="1"
                                        Command="{Binding OpenFullScreenPageCommand}"
                                        CommandParameter="Messages"
                                        Style="{StaticResource GhostPillBtnStyle}"
                                        Background="#FFF8D6"
                                        BorderBrush="#E8B800"
                                        Padding="7,3"
                                        Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔔" FontSize="11" />
                                        <TextBlock Text="{Binding UnreadNotificationCount}"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="#FF4A26"
                                                   Margin="2,0,0,0" />
                                    </StackPanel>
                                </Button>

                                <!-- 顶部账号/立即登录醒目胶囊 -->
                                <Button Grid.Column="2"
                                        Command="{Binding OpenLoginViewCommand}"
                                        Style="{StaticResource FlatActionBtnStyle}"
                                        Background="#222426"
                                        Foreground="#FFD100"
                                        Padding="9,3.5">
                                    <TextBlock Text="{Binding TopLoginPillText}" FontSize="11" FontWeight="Bold" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </Grid>

                            <!-- 第二行：美团外卖圆角搜索框 -->
                            <Border Background="#FFFFFF" CornerRadius="18" BorderBrush="#222426" BorderThickness="1.2" Padding="10,3,4,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             FontSize="12.5"
                                             Foreground="#222426"
                                             ToolTip="搜索商家名或招牌菜（如：黄焖鸡、果茶、粿条）" />
                                    <Button Grid.Column="2"
                                            Command="{Binding ResetFilterCommand}"
                                            Style="{StaticResource FlatActionBtnStyle}"
                                            Padding="12,4"
                                            FontSize="11.5"
                                            Content="搜全城" />
                                </Grid>
                            </Border>

                            <!-- 第三行：热搜词胶囊栏 -->
                            <ItemsControl ItemsSource="{Binding HotSearchKeywords}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyHotKeywordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Margin="0,0,5,3"
                                                Background="#88FFFFFF"
                                                BorderThickness="0"
                                                Padding="7,2">
                                            <TextBlock Text="{Binding}" FontSize="10.5" Foreground="#333537" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 首页主信息流滚动区：10宫格金刚区 + 神券横幅 + 4维排序 + 门店瀑布流 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,2,10,52">
                        <StackPanel>

                            <!-- 10 宫格金刚区 (2行×5列) -->
                            <Border Style="{StaticResource CardBorderStyle}" Padding="6,8,6,4" Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding KingKongItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectKingKongCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Margin="2,2,2,6">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Grid Width="42" Height="42">
                                                        <Border Background="{Binding IconBgHex}" CornerRadius="14" />
                                                        <Image Source="{Binding IconSource}"
                                                               Width="30"
                                                               Height="30"
                                                               Visibility="{Binding HasBitmapIcon, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding IconGlyph}"
                                                                   FontSize="20"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="#FF4A26"
                                                                CornerRadius="6"
                                                                Padding="3,0.5"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,-3,-4,0"
                                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="8.5" Foreground="#FFFFFF" FontWeight="Bold" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#222426"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- 美团神券天天膨胀横幅 -->
                            <Border CornerRadius="12" Padding="11,8" Margin="0,0,0,8" BorderBrush="#F5C77E" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFF5D6" Offset="0.0" />
                                        <GradientStop Color="#FFE7BA" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#FF4A26" CornerRadius="8" Padding="6,4" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="🧧 神券" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="美团神券节 · 天天免费膨胀领大额券" FontSize="12" FontWeight="Bold" Foreground="#5C2D0C" />
                                        <TextBlock Text="{Binding SelectedCouponSummary}" FontSize="10.5" Foreground="#9A4D18" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Command="{Binding InflateCouponCommand}"
                                            Style="{StaticResource FlatActionBtnStyle}"
                                            Background="#FF4A26"
                                            Foreground="#FFFFFF"
                                            Padding="10,4"
                                            FontSize="11"
                                            Content="立即膨胀" />
                                </Grid>
                            </Border>

                            <!-- 4 维综合排序筛选栏 -->
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding ChangeSortModeCommand}" CommandParameter="综合排序" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,4,0" Content="综合排序" />
                                <Button Grid.Column="1" Command="{Binding ChangeSortModeCommand}" CommandParameter="销量最高" Style="{StaticResource GhostPillBtnStyle}" Margin="2,0,2,0" Content="销量最高" />
                                <Button Grid.Column="2" Command="{Binding ChangeSortModeCommand}" CommandParameter="速度最快" Style="{StaticResource GhostPillBtnStyle}" Margin="2,0,2,0" Content="速度最快" />
                                <Button Grid.Column="3" Command="{Binding ChangeSortModeCommand}" CommandParameter="评分最高" Style="{StaticResource GhostPillBtnStyle}" Margin="4,0,0,0" Content="好评优先" />
                            </Grid>

                            <!-- 门店瀑布流列表 (点击进入门店详情全屏页) -->
                            <ItemsControl ItemsSource="{Binding FilteredPois}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="68" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 门店头像与品牌金标 -->
                                                    <Grid Grid.Column="0" Width="62" Height="62" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                        <Border Background="{Binding BannerAccentHex}" CornerRadius="12">
                                                            <TextBlock Text="{Binding LogoEmoji}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Background="#222426"
                                                                CornerRadius="4"
                                                                Padding="4,1"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Visibility="{Binding IsBrandGold, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="品牌" FontSize="9" FontWeight="Bold" Foreground="#FFD100" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- 门店主体信息 -->
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="#222426"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding DataContext.SelectPoiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource FlatActionBtnStyle}"
                                                                    Padding="10,3"
                                                                    FontSize="11"
                                                                    Content="进店点餐" />
                                                        </Grid>

                                                        <!-- 评分、月售、配送时间与距离 -->
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="★ " FontSize="11.5" FontWeight="Bold" Foreground="#FF6B00" />
                                                                <TextBlock Text="{Binding FormattedPoiScore}" FontSize="12" FontWeight="Bold" Foreground="#FF6B00" Margin="0,0,3,0" />
                                                                <TextBlock Text="分" FontSize="10.5" Foreground="#FF6B00" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding MonthSalesTip}" FontSize="11" Foreground="#66686B" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding MtDeliveryTime}" FontSize="11" Foreground="#66686B" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding Distance}" FontSize="11" Foreground="#66686B" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- 起送价、配送费与美团专送角标 -->
                                                        <Grid Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding MinPriceTip}" FontSize="11" Foreground="#66686B" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding ShippingFee, StringFormat='配送 ¥{0:0.##}'}" FontSize="11" Foreground="#66686B" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding AveragePriceTip}" FontSize="11" Foreground="#999B9E" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="#FFF6CC" BorderBrush="#FFD100" BorderThickness="1" CornerRadius="4" Padding="4,1">
                                                                <TextBlock Text="{Binding DeliveryTypeText}" FontSize="9.5" FontWeight="Bold" Foreground="#7A5200" />
                                                            </Border>
                                                        </Grid>

                                                        <!-- 口碑榜单与满减神券标签 -->
                                                        <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                            <Border Background="#FFF3E6" CornerRadius="4" Padding="5,1.5" Margin="0,0,5,3">
                                                                <TextBlock Text="{Binding RankLabelInfo}" FontSize="10" Foreground="#C85A14" FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border Background="#FFF0EE" BorderBrush="#FFCCC4" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,5,3">
                                                                <TextBlock Text="30减5 · 50减12 · 80减22" FontSize="10" Foreground="#E03820" />
                                                            </Border>
                                                            <Border Background="#FFF8DE" BorderBrush="#F2D58C" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,0,3">
                                                                <TextBlock Text="🧧 神券可膨胀" FontSize="10" Foreground="#A86410" />
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== Tab 9: 神券省钱卡 (WMVIPCardKNBFragment) ==================== -->
                <ScrollViewer Visibility="{Binding IsShenQuanTabActive, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="12,10,12,52">
                    <StackPanel>
                        <!-- 黑金神券省钱卡顶部横幅 -->
                        <Border Background="#222426" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="👑 美团神券省钱卡 · 尊享会员" FontSize="15" FontWeight="Bold" Foreground="#FFD100" />
                                        <TextBlock Text="天天必得膨胀神券 · 全场大牌商家通用直减" FontSize="11" Foreground="#D0C4A8" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding InflateCouponCommand}"
                                            Style="{StaticResource FlatActionBtnStyle}"
                                            Padding="11,5"
                                            FontSize="11.5"
                                            Content="一键膨胀" />
                                </Grid>
                                <Border Background="#32353A" CornerRadius="8" Padding="10,6" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding SelectedCouponSummary, StringFormat='当前选中抵扣券：{0}'}"
                                               FontSize="11.5"
                                               Foreground="#FFE57F" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 口令兑换红包卡片 (OBL-23) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🧧 口令兑换美团神券红包" FontSize="13" FontWeight="Bold" Foreground="#222426" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F4F5F7" CornerRadius="8" Padding="8,4" Margin="0,0,8,0">
                                        <TextBox Text="{Binding CouponRedeemCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="12"
                                                 VerticalContentAlignment="Center" />
                                    </Border>
                                    <Button Grid.Column="1"
                                            Command="{Binding RedeemCouponCodeCommand}"
                                            Style="{StaticResource FlatActionBtnStyle}"
                                            Padding="14,6"
                                            FontSize="12"
