                <Grid Grid.Row="2">

                    <!-- 子页 1: 点菜 (左分类 + 右菜品列表, OBL-14) -->
                    <Grid Visibility="{Binding IsPoiMenuSubTab, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧菜品分类栏 -->
                        <Border Grid.Column="0" Background="#F4F5F7" BorderBrush="#ECEEF2" BorderThickness="0,0,1,0">
                            <ItemsControl ItemsSource="{Binding CurrentMenuCategories}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectMenuCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,12">
                                            <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" Foreground="#333537" TextWrapping="Wrap" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- 右侧菜品 SPU 列表 -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#FFFFFF" Padding="8,6">
                            <ItemsControl ItemsSource="{Binding FilteredFoods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F2F3F5" BorderThickness="0,0,0,1" Padding="4,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="60" Height="60" CornerRadius="10" Background="{Binding ThumbAccentHex}" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding EmojiIcon}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="#222426" />
                                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="#66686B" Margin="0,2,0,2" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding MonthSaledContent}" FontSize="10" Foreground="#999B9E" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding PraiseContent}" FontSize="10" Foreground="#FF6B00" />
                                                    </StackPanel>

                                                    <Grid Margin="0,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MinPrice, StringFormat='¥{0:0.##}'}" FontSize="15" FontWeight="Bold" Foreground="#FF4A26" />
                                                            <TextBlock Text="{Binding OriginPrice, StringFormat='¥{0:0.##}'}" FontSize="10.5" Foreground="#999B9E" TextDecorations="Strikethrough" VerticalAlignment="Bottom" Margin="4,0,0,1" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding DataContext.OpenSpecModalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostPillBtnStyle}"
                                                                    Padding="7,2"
                                                                    FontSize="10.5"
                                                                    Margin="0,0,4,0"
                                                                    Content="选规格" />
                                                            <Button Command="{Binding DataContext.RemoveFoodCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostPillBtnStyle}"
                                                                    Padding="6,1"
                                                                    Visibility="{Binding HasSelectedCount, Converter={StaticResource BoolToVis}}"
                                                                    Content="-" />
                                                            <TextBlock Text="{Binding SelectedCount}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center"
                                                                       Margin="5,0"
                                                                       Visibility="{Binding HasSelectedCount, Converter={StaticResource BoolToVis}}" />
                                                            <Button Command="{Binding DataContext.AddFoodCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource FlatActionBtnStyle}"
                                                                    Padding="8,2"
                                                                    FontSize="12"
                                                                    Content="+" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 子页 2: 评价 (PoiCommentFragment, OBL-15) -->
                    <ScrollViewer Visibility="{Binding IsPoiReviewSubTab, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10,8">
                        <StackPanel>
                            <!-- 门店综合评分卡 -->
                            <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedPoi.FormattedPoiScore}" FontSize="26" FontWeight="Bold" Foreground="#FF6B00" HorizontalAlignment="Center" />
                                        <TextBlock Text="商家综合评分" FontSize="10" Foreground="#66686B" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="口味评分：★★★★★ 4.9" FontSize="11.5" Foreground="#333537" />
                                        <TextBlock Text="包装评分：★★★★★ 4.8" FontSize="11.5" Foreground="#333537" Margin="0,2" />
                                        <TextBlock Text="配送满意度：99% (美团专送准时达)" FontSize="11.5" Foreground="#333537" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 评价筛选胶囊栏 -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Command="{Binding SelectReviewFilterCommand}" CommandParameter="全部" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,6,0" Content="全部评价" />
                                <Button Command="{Binding SelectReviewFilterCommand}" CommandParameter="好评" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,6,0" Content="好评优先" />
                                <Button Command="{Binding SelectReviewFilterCommand}" CommandParameter="有图" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,6,0" Content="📸 有图评价" />
                                <Button Command="{Binding SelectReviewFilterCommand}" CommandParameter="差评" Style="{StaticResource GhostPillBtnStyle}" Content="中差评" />
                            </WrapPanel>

                            <!-- 真实评价列表 -->
                            <ItemsControl ItemsSource="{Binding FilteredPoiReviews}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding AvatarEmoji}" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding UserName}" FontSize="12.5" FontWeight="Bold" Foreground="#222426" Margin="0,0,6,0" />
                                                            <Border Background="#FFF6CC" CornerRadius="4" Padding="4,1">
                                                                <TextBlock Text="{Binding VipLevelText}" FontSize="9.5" Foreground="#8A5A00" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding StarText}" FontSize="10.5" Foreground="#FF6B00" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="10.5" Foreground="#999B9E" />
                                                </Grid>

                                                <TextBlock Text="{Binding Content}" FontSize="12" Foreground="#222426" TextWrapping="Wrap" Margin="0,6,0,4" />

                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                    <Border Background="#FFF0EE" CornerRadius="4" Padding="5,1" Margin="0,0,6,0" Visibility="{Binding HasPictures, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding PictureBadgeText}" FontSize="10" Foreground="#E03820" />
                                                    </Border>
                                                    <TextBlock Text="{Binding OrderedDishesText, StringFormat='点过：{0}'}" FontSize="10.5" Foreground="#999B9E" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Border Background="#F7F8FA" CornerRadius="6" Padding="8,6">
                                                    <TextBlock Text="{Binding MerchantReply}" FontSize="11" Foreground="#66686B" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 子页 3: 商家档案与食品安全公示 (PoiDetailInfoFragment, OBL-16) -->
                    <ScrollViewer Visibility="{Binding IsPoiMerchantSubTab, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10,8">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="🏪 门店基本信息" FontSize="13.5" FontWeight="Bold" Foreground="#222426" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding SelectedPoi.MerchantArchive.Address, StringFormat='📍 门店地址：{0}'}" FontSize="12" Foreground="#333537" TextWrapping="Wrap" Margin="0,2" />
                                    <TextBlock Text="{Binding SelectedPoi.MerchantArchive.Phone, StringFormat='📞 商家电话：{0}'}" FontSize="12" Foreground="#333537" Margin="0,2" />
                                    <TextBlock Text="{Binding SelectedPoi.MerchantArchive.BusinessHours, StringFormat='🕒 营业时间：{0}'}" FontSize="12" Foreground="#333537" Margin="0,2" />
                                    <TextBlock Text="{Binding SelectedPoi.MerchantArchive.DeliveryServiceText, StringFormat='🛵 配送服务：{0}'}" FontSize="12" Foreground="#333537" TextWrapping="Wrap" Margin="0,2" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="🛡️ 食品安全监督量化公示档案" FontSize="13.5" FontWeight="Bold" Foreground="#1E7E34" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding SelectedPoi.MerchantArchive.FoodSafetyGrade, StringFormat='😊 量化等级：{0}'}" FontSize="12" FontWeight="Bold" Foreground="#1E7E34" Margin="0,2" />
                                    <TextBlock Text="{Binding SelectedPoi.MerchantArchive.LicenseNumber, StringFormat='📜 食品经营许可证：{0}'}" FontSize="12" Foreground="#333537" Margin="0,2" />
                                    <TextBlock Text="{Binding SelectedPoi.MerchantArchive.KitchenInspectionText}" FontSize="11.5" Foreground="#66686B" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="✨ 商家安心服务保障" FontSize="13.5" FontWeight="Bold" Foreground="#222426" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding SelectedPoi.MerchantArchive.ServiceGuarantees}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='✔ {0}'}" FontSize="11.5" Foreground="#333537" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 门店详情底部黑金悬浮购物车结算条 (OBL-19) -->
                <Border Grid.Row="3" Background="#222426" Margin="10,4,10,6" CornerRadius="24" Padding="12,0,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding ToggleCartDrawerCommand}"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#FFD100" CornerRadius="16" Width="34" Height="34" Margin="0,0,8,0">
                                    <TextBlock Text="🛍️" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CartPrice.TotalDiscountedAndBoxPrice, StringFormat='¥{0:0.00}'}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding CartPrice.CrossTip}"
                                                   FontSize="10.5"
                                                   Foreground="#FFD100"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,0,2" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CartPrice.FinalShippingFee, StringFormat='另需配送费 ¥{0:0.##} · 点击查看双口袋明细'}"
                                               FontSize="9.5"
                                               Foreground="#A8ACB0" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Command="{Binding CheckoutOrderCommand}"
                                Style="{StaticResource FlatActionBtnStyle}"
                                Padding="16,10"
                                FontSize="13"
                                Content="{Binding CartPrice.CheckoutButtonText}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== P2: 确认订单全屏页 (OrderConfirmActivity, OBL-20 ~ OBL-21) ==================== -->
            <Grid Background="#F4F5F7" Visibility="{Binding IsOrderConfirmPageOpen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>

                <!-- 顶部返回与标题 -->
                <Border Grid.Row="0" Background="{StaticResource MtHeaderGradient}" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding BackToMobileFeedCommand}" Style="{StaticResource GhostPillBtnStyle}" Content="‹ 返回点菜" />
                        <TextBlock Grid.Column="1" Text="确认订单" FontSize="15" FontWeight="Bold" Foreground="#222426" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Command="{Binding SetDeliveryModeCommand}" CommandParameter="Delivery" Style="{StaticResource GhostPillBtnStyle}" Padding="7,3" Margin="0,0,4,0" Content="外卖配送" />
                            <Button Command="{Binding SetDeliveryModeCommand}" CommandParameter="Pickup" Style="{StaticResource GhostPillBtnStyle}" Padding="7,3" Content="到店自取" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 确认订单主体卡片流 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,6">
                    <StackPanel>
                        <!-- 收货地址与预计送达时间卡 -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentAddressDisplayText}" FontSize="14" FontWeight="Bold" Foreground="#222426" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding CurrentAddress.ContactName}" FontSize="11.5" Foreground="#66686B" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding CurrentAddress.GenderText}" FontSize="11.5" Foreground="#66686B" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding CurrentAddress.Phone}" FontSize="11.5" Foreground="#66686B" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding OpenFullScreenPageCommand}"
                                            CommandParameter="AddressManager"
                                            Style="{StaticResource GhostPillBtnStyle}"
                                            VerticalAlignment="Center"
                                            Content="修改地址 ›" />
                                </Grid>
                                <Border Background="#FFF9E6" CornerRadius="6" Padding="8,5" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding SelectedPoi.MtDeliveryTime, StringFormat='⚡ 立即送出 · 预计 {0} 内送达 (赠准时宝延误险)'}" FontSize="11" FontWeight="SemiBold" Foreground="#8A5A00" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 餐品清单与费用算价明细卡 -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedPoi.Name}" FontSize="13.5" FontWeight="Bold" Foreground="#222426" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding ActiveCartItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="65" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FoodName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#222426" />
                                                    <TextBlock Text="{Binding SpecSummary}" FontSize="10.5" Foreground="#999B9E" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='x{0}'}" FontSize="12" Foreground="#66686B" VerticalAlignment="Center" Margin="8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding LineTotal, StringFormat='¥{0:0.00}'}" FontSize="12.5" FontWeight="Bold" Foreground="#222426" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border BorderBrush="#F0F1F4" BorderThickness="0,1,0,0" Margin="0,8,0,6" Padding="0,6,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="打包费" FontSize="11.5" Foreground="#66686B" />
                                            <TextBlock Text="{Binding CartPrice.TotalBoxPrice, StringFormat='¥{0:0.00}'}" FontSize="11.5" Foreground="#222426" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="配送费 (美团专送)" FontSize="11.5" Foreground="#66686B" />
                                            <TextBlock Text="{Binding CartPrice.FinalShippingFee, StringFormat='¥{0:0.00}'}" FontSize="11.5" Foreground="#222426" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="店铺满减优惠" FontSize="11.5" Foreground="#FF4A26" />
                                            <TextBlock Text="{Binding CartPrice.AppliedFullReductionAmount, StringFormat='-¥{0:0.00}'}" FontSize="11.5" FontWeight="Bold" Foreground="#FF4A26" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="美团神券红包" FontSize="11.5" Foreground="#FF4A26" />
                                            <TextBlock Text="{Binding CartPrice.AppliedCouponAmount, StringFormat='-¥{0:0.00}'}" FontSize="11.5" FontWeight="Bold" Foreground="#FF4A26" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 备注、餐具与隐私号保护卡 (OBL-21) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="12,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="🔒 号码保护 (隐私小号)" FontSize="12.5" FontWeight="Bold" Foreground="#222426" />
                                        <TextBlock Text="对商家和骑手隐藏您的真实手机号，保障隐私安全" FontSize="10" Foreground="#66686B" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsPrivacyPhoneProtected}" VerticalAlignment="Center" Content="已开启" FontSize="11" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🍴 餐具份数" FontSize="12" FontWeight="SemiBold" Foreground="#222426" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding CycleTablewareCommand}"
                                            Style="{StaticResource GhostPillBtnStyle}"
                                            HorizontalAlignment="Right"
                                            Content="{Binding SelectedTablewareOption}" />
                                </Grid>

                                <TextBlock Text="📝 订单备注" FontSize="12" FontWeight="SemiBold" Foreground="#222426" Margin="0,0,0,4" />
                                <Border Background="#F4F5F7" CornerRadius="8" Padding="8,4">
                                    <TextBox Text="{Binding OrderNoteInput, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="11.5" />
                                </Border>
                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Command="{Binding AppendOrderNoteTagCommand}" CommandParameter="少辣" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,5,3" Content="+ 少辣" />
                                    <Button Command="{Binding AppendOrderNoteTagCommand}" CommandParameter="不要香菜" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,5,3" Content="+ 不要香菜" />
                                    <Button Command="{Binding AppendOrderNoteTagCommand}" CommandParameter="放前台外卖柜" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,5,3" Content="+ 放外卖柜" />
                                    <Button Command="{Binding AppendOrderNoteTagCommand}" CommandParameter="多给餐巾纸" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,0,3" Content="+ 多给纸巾" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 确认订单底部提交支付条 -->
                <Border Grid.Row="2" Background="#222426" Margin="10,4,10,6" CornerRadius="24" Padding="14,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="待支付 " FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                                <TextBlock Text="{Binding OrderConfirmFinalPayable, StringFormat='¥{0:0.00}'}" FontSize="18" FontWeight="Bold" Foreground="#FFD100" />
                            </StackPanel>
                            <TextBlock Text="{Binding CartPrice.TotalSavedAmount, StringFormat='已为您优惠 ¥{0:0.00}'}" FontSize="10" Foreground="#A8ACB0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding OpenCashierModalCommand}"
                                Style="{StaticResource FlatActionBtnStyle}"
                                Padding="18,10"
                                FontSize="13.5"
                                Content="提交订单" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== P3: 订单详情与骑手实时地图轨迹页 (OrderDetailActivity, OBL-26 ~ OBL-29) ==================== -->
            <Grid Background="#F4F5F7" Visibility="{Binding IsOrderTrackPageOpen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF" Padding="12,8" BorderBrush="#ECEEF2" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding BackToMobileFeedCommand}" Style="{StaticResource GhostPillBtnStyle}" Content="‹ 返回订单" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.StatusDescription}" FontSize="14.5" FontWeight="Bold" Foreground="#222426" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Command="{Binding AdvanceRiderStepCommand}" Style="{StaticResource FlatActionBtnStyle}" Padding="9,4" FontSize="10.5" Content="推进轨迹" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel>
                        <!-- 骑手实时配送地图画布 -->
                        <Border Height="156" CornerRadius="14" BorderBrush="#DDE2E8" BorderThickness="1" Margin="0,0,0,8" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E8F4EC" Offset="0.0" />
                                    <GradientStop Color="#DCEBF7" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="12">
                                <StackPanel VerticalAlignment="Top">
                                    <Border Background="#DD222426" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding SelectedOrderCoordinatesText}" FontSize="10.5" Foreground="#FFD100" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <!-- 商家 -> 骑手 -> 收货人路线示意 -->
                                <Grid VerticalAlignment="Center" Margin="6,16,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#FFFFFF" CornerRadius="10" Padding="6,4" BorderBrush="#CCCCCC" BorderThickness="1">
                                        <TextBlock Text="🏪 商家出餐" FontSize="10.5" FontWeight="Bold" />
                                    </Border>
                                    <Border Grid.Column="1" Height="3" Background="#FFD100" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#FFD100" CornerRadius="14" Padding="10,5" BorderBrush="#222426" BorderThickness="1.5">
                                        <TextBlock Text="{Binding SelectedOrder.RiderName, StringFormat='🛵 {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#222426" />
                                    </Border>
                                    <Border Grid.Column="3" Height="3" Background="#B8C4CE" VerticalAlignment="Center" />
                                    <Border Grid.Column="4" Background="#FFFFFF" CornerRadius="10" Padding="6,4" BorderBrush="#CCCCCC" BorderThickness="1">
                                        <TextBlock Text="🏠 收货地址" FontSize="10.5" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <TextBlock VerticalAlignment="Bottom"
                                           Text="{Binding SelectedOrder.ArrivalTimeText}"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="#1F5E3B" />
                            </Grid>
                        </Border>

                        <!-- 订单快捷操作栏 -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,8">
                            <UniformGrid Columns="4">
                                <Button Command="{Binding ReorderCommand}" Style="{StaticResource GhostPillBtnStyle}" Margin="2" Content="再来一单" />
                                <Button Command="{Binding ConfirmOrderReceivedCommand}" Style="{StaticResource FlatActionBtnStyle}" Margin="2" Padding="6,4" FontSize="11" Content="确认收货" />
                                <Button Command="{Binding OpenOrderReviewModalCommand}" Style="{StaticResource GhostPillBtnStyle}" Margin="2" Content="评价晒单" />
                                <Button Command="{Binding CancelOrderCommand}" Style="{StaticResource GhostPillBtnStyle}" Foreground="#D9381E" Margin="2" Content="申请退款" />
                            </UniformGrid>
                        </Border>

                        <!-- 骑手与商家三方 IM 群聊卡片 (OBL-27) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="💬 骑手 · 商家 · 顾客 三方实时沟通群" FontSize="13" FontWeight="Bold" Foreground="#222426" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding SelectedOrder.ImMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F7F8FA" CornerRadius="8" Padding="8,5" Margin="0,0,0,5">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SenderName}" FontSize="11" FontWeight="Bold" Foreground="#FF6B00" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#999B9E" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Content}" FontSize="11.5" Foreground="#222426" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 快捷短语 -->
                                <ItemsControl ItemsSource="{Binding SelectedOrder.SmartReplySuggestions}" Margin="0,4,0,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SendSmartReplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GhostPillBtnStyle}"
                                                    Margin="0,0,5,4"
                                                    Padding="7,2.5"
                                                    Content="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F4F5F7" CornerRadius="8" Padding="8,4" Margin="0,0,6,0">
                                        <TextBox Text="{Binding ImDraftText, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="11.5" />
                                    </Border>
                                    <Button Grid.Column="1"
                                            Command="{Binding SendImMessageCommand}"
                                            Style="{StaticResource FlatActionBtnStyle}"
                                            Padding="12,5"
                                            FontSize="11.5"
                                            Content="发送消息" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 配送时间轴 -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="🕒 订单配送时间轴" FontSize="13" FontWeight="Bold" Foreground="#222426" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding SelectedOrder.TrackingSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}" FontSize="11" FontWeight="Bold" Foreground="#66686B" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#222426" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#66686B" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== P4: 收货地址管理与新增页 (MineAddressActivity, OBL-32) ==================== -->
            <Grid Background="#F4F5F7" Visibility="{Binding IsAddressManagerPageOpen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF" Padding="12,8" BorderBrush="#ECEEF2" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding BackToMobileFeedCommand}" Style="{StaticResource GhostPillBtnStyle}" Content="‹ 返回" />
                        <TextBlock Grid.Column="1" Text="我的收货地址" FontSize="15" FontWeight="Bold" Foreground="#222426" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel>
                        <!-- 现有地址列表 -->
                        <ItemsControl ItemsSource="{Binding Addresses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#FFF6CC" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding TagLabel}" FontSize="10" FontWeight="Bold" Foreground="#8A5A00" />
                                                    </Border>
                                                    <TextBlock Text="{Binding AddressDetail}" FontSize="13" FontWeight="Bold" Foreground="#222426" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding HouseNumber}" FontSize="11.5" Foreground="#333537" Margin="0,2,0,2" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ContactName}" FontSize="11" Foreground="#66686B" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding GenderText}" FontSize="11" Foreground="#66686B" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="#66686B" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.SelectAddressCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource FlatActionBtnStyle}"
                                                        Padding="10,3"
                                                        FontSize="10.5"
                                                        Margin="0,0,0,4"
                                                        Content="使用该地址" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Command="{Binding DataContext.StartEditAddressCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostPillBtnStyle}"
                                                            Padding="7,2"
                                                            FontSize="10"
                                                            Margin="0,0,4,0"
                                                            Content="编辑" />
                                                    <Button Command="{Binding DataContext.DeleteAddressCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostPillBtnStyle}"
                                                            Padding="7,2"
                                                            FontSize="10"
                                                            Content="删除" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 新增/编辑收货地址表单 (ModifyAddressActivityDelegate) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding AddressFormTitleText}" FontSize="13.5" FontWeight="Bold" Foreground="#222426" Margin="0,0,0,8" />

                                <TextBlock Text="收货人姓名与称呼" FontSize="11" Foreground="#66686B" />
                                <Grid Margin="0,3,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F4F5F7" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                        <TextBox Text="{Binding EditAddressContactName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="12" />
                                    </Border>
                                    <Button Grid.Column="1" Command="{Binding SetEditAddressGenderCommand}" CommandParameter="先生" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,4,0" Content="先生" />
                                    <Button Grid.Column="2" Command="{Binding SetEditAddressGenderCommand}" CommandParameter="女士" Style="{StaticResource GhostPillBtnStyle}" Content="女士" />
                                </Grid>

                                <TextBlock Text="手机号码" FontSize="11" Foreground="#66686B" />
                                <Border Background="#F4F5F7" CornerRadius="6" Padding="8,4" Margin="0,3,0,6">
                                    <TextBox Text="{Binding EditAddressPhone, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="12" />
                                </Border>

                                <TextBlock Text="小区/写字楼/学校详细地址" FontSize="11" Foreground="#66686B" />
                                <Border Background="#F4F5F7" CornerRadius="6" Padding="8,4" Margin="0,3,0,6">
                                    <TextBox Text="{Binding EditAddressDetail, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="12" />
                                </Border>

                                <TextBlock Text="楼号/门牌号与标签" FontSize="11" Foreground="#66686B" />
                                <Grid Margin="0,3,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F4F5F7" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                        <TextBox Text="{Binding EditAddressHouseNumber, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="12" />
                                    </Border>
                                    <Button Grid.Column="1" Command="{Binding SetEditAddressTagCommand}" CommandParameter="家" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,3,0" Content="家" />
                                    <Button Grid.Column="2" Command="{Binding SetEditAddressTagCommand}" CommandParameter="公司" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,3,0" Content="公司" />
                                    <Button Grid.Column="3" Command="{Binding SetEditAddressTagCommand}" CommandParameter="学校" Style="{StaticResource GhostPillBtnStyle}" Content="学校" />
                                </Grid>

                                <Button Command="{Binding SaveNewAddressCommand}"
                                        Style="{StaticResource FlatActionBtnStyle}"
                                        Padding="14,8"
                                        FontSize="13"
                                        Content="{Binding AddressFormSubmitText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== P5: 我的收藏门店页 (OBL-17) ==================== -->
            <Grid Background="#F4F5F7" Visibility="{Binding IsFavoritesPageOpen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FFFFFF" Padding="12,8" BorderBrush="#ECEEF2" BorderThickness="0,0,0,1">
                    <Grid>
                        <Button Command="{Binding BackToMobileFeedCommand}" Style="{StaticResource GhostPillBtnStyle}" HorizontalAlignment="Left" Content="‹ 返回" />
                        <TextBlock Text="❤ 我的收藏门店" FontSize="15" FontWeight="Bold" Foreground="#222426" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <ItemsControl ItemsSource="{Binding FavoritePois}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding LogoEmoji}" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="#222426" />
                                            <TextBlock Text="{Binding BrandSlogan}" FontSize="11" Foreground="#66686B" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Command="{Binding DataContext.SelectPoiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource FlatActionBtnStyle}"
                                                VerticalAlignment="Center"
                                                Content="去点餐" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ==================== P6: 消息通知中心页 (MessageCenterActivity, OBL-33) ==================== -->
            <Grid Background="#F4F5F7" Visibility="{Binding IsMessagesPageOpen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FFFFFF" Padding="12,8" BorderBrush="#ECEEF2" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding BackToMobileFeedCommand}" Style="{StaticResource GhostPillBtnStyle}" Content="‹ 返回" />
                        <TextBlock Grid.Column="1" Text="消息通知中心" FontSize="15" FontWeight="Bold" Foreground="#222426" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Command="{Binding MarkAllNotificationsReadCommand}" Style="{StaticResource GhostPillBtnStyle}" Content="全部已读" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <ItemsControl ItemsSource="{Binding Notifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IconEmoji}" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="#FF6B00" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="#999B9E" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#222426" Margin="0,4,0,2" />
                                        <TextBlock Text="{Binding Content}" FontSize="11.5" Foreground="#66686B" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 第三层：半屏 BottomSheet 弹窗与全屏美团通行证登录模态层                      -->
            <!-- ========================================================================= -->

            <!-- M1: 菜品多规格 SKU 与属性弹窗 (OBL-18) -->
            <Border Background="#77000000" Visibility="{Binding IsSpecModalOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#FFFFFF" CornerRadius="16" Margin="18" Padding="16,14" VerticalAlignment="Center">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding SpecModalFood.Name}" FontSize="15" FontWeight="Bold" Foreground="#222426" />
                            <Button Command="{Binding CloseSpecModalCommand}" Style="{StaticResource GhostPillBtnStyle}" HorizontalAlignment="Right" Content="✕" />
                        </Grid>
                        <TextBlock Text="选择份量规格 (SKU)" FontSize="11.5" FontWeight="SemiBold" Foreground="#66686B" Margin="0,10,0,4" />
                        <ItemsControl ItemsSource="{Binding SpecModalFood.Skus}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectSpecSkuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource GhostPillBtnStyle}"
                                            Margin="0,0,6,6">
                                        <TextBlock>
                                            <Run Text="{Binding SpecName}" FontWeight="Bold" />
                                            <Run Text="{Binding Price, StringFormat=' ¥{0:0.##}'}" Foreground="#FF4A26" />
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="口味属性偏好 (点击切换选项)" FontSize="11.5" FontWeight="SemiBold" Foreground="#66686B" Margin="0,6,0,4" />
                        <ItemsControl ItemsSource="{Binding SpecModalFood.AttrGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="{Binding GroupName}" FontSize="12" Foreground="#222426" VerticalAlignment="Center" />
                                        <Button Command="{Binding DataContext.CycleAttrOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostPillBtnStyle}"
                                                HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SelectedOption, StringFormat='当前：{0} (点击切换)'}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#FFF9E6" CornerRadius="8" Padding="10,6" Margin="0,10,0,10">
                            <TextBlock Text="{Binding SpecModalPreviewText}" FontSize="11.5" FontWeight="Bold" Foreground="#8A5A00" />
                        </Border>

                        <Button Command="{Binding ConfirmSpecModalCommand}"
                                Style="{StaticResource FlatActionBtnStyle}"
                                Padding="14,8"
                                FontSize="13"
                                Content="加入购物车口袋" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- M2: 双口袋购物车上拉抽屉 (OBL-19) -->
            <Border Background="#77000000" Visibility="{Binding IsCartDrawerOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#FFFFFF" CornerRadius="16,16,0,0" VerticalAlignment="Bottom" Padding="14,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding ActivePocketLabel, StringFormat='🛍️ 已选餐品明细 (当前操作：{0})'}" FontSize="13.5" FontWeight="Bold" Foreground="#222426" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding ClearCartCommand}" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,6,0" Content="🗑️ 清空" />
                                <Button Command="{Binding ToggleCartDrawerCommand}" Style="{StaticResource GhostPillBtnStyle}" Content="收起" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ActiveCartItems}" MaxHeight="240">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FoodName}" FontSize="12.5" FontWeight="Bold" Foreground="#222426" />
                                            <TextBlock Text="{Binding PocketId, StringFormat='{}{0}号口袋'}" FontSize="10" Foreground="#FF6B00" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='x{0}'}" FontSize="12" VerticalAlignment="Center" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding LineTotal, StringFormat='¥{0:0.00}'}" FontSize="12.5" FontWeight="Bold" Foreground="#FF4A26" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{Binding CheckoutOrderCommand}"
                                Style="{StaticResource FlatActionBtnStyle}"
                                Margin="0,10,0,0"
                                Padding="14,8"
                                FontSize="13"
                                Content="去结算 (进入确认订单页)" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- M3: 美团收银台半屏支付弹窗 (MTCashierActivity, OBL-22) -->
            <Border Background="#88000000" Visibility="{Binding IsCashierModalOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#FFFFFF" CornerRadius="18,18,0,0" VerticalAlignment="Bottom" Padding="16,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="美团收银台" FontSize="15" FontWeight="Bold" Foreground="#222426" HorizontalAlignment="Center" />
                            <Button Command="{Binding CloseCashierModalCommand}" Style="{StaticResource GhostPillBtnStyle}" HorizontalAlignment="Right" Content="✕" />
                        </Grid>
                        <StackPanel HorizontalAlignment="Center" Margin="0,10,0,10">
                            <TextBlock Text="{Binding CashierCountdownText}" FontSize="11" Foreground="#66686B" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CashierFinalPayable, StringFormat='¥{0:0.00}'}" FontSize="28" FontWeight="Bold" Foreground="#222426" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding SelectedPoi.Name}" FontSize="11" Foreground="#999B9E" HorizontalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding PaymentMethods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Background="#F7F8FA"
                                            BorderBrush="#E2E4E8"
                                            BorderThickness="1"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <Grid Width="355">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IconEmoji}" FontSize="18" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#222426" Margin="0,0,6,0" />
                                                    <Border Background="#FFF0EE" CornerRadius="4" Padding="4,1">
                                                        <TextBlock Text="{Binding RecommendTag}" FontSize="9.5" FontWeight="Bold" Foreground="#FF4A26" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#66686B" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="✔" FontSize="14" FontWeight="Bold" Foreground="#FF6B00" VerticalAlignment="Center" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Command="{Binding ConfirmCashierPaymentCommand}"
                                Style="{StaticResource FlatActionBtnStyle}"
                                Margin="0,8,0,0"
                                Padding="14,10"
                                FontSize="14">
                            <TextBlock Text="{Binding CashierFinalPayable, StringFormat='确认支付 ¥{0:0.00}'}" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Border>
            </Border>

            <!-- M4: 订单五星评价晒单弹窗 (OrderCommentActivity, OBL-30) -->
            <Border Background="#88000000" Visibility="{Binding IsReviewOrderModalOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#FFFFFF" CornerRadius="16" Margin="18" Padding="16,14" VerticalAlignment="Center">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="🌟 评价晒单领 50 团币" FontSize="15" FontWeight="Bold" Foreground="#222426" />
                            <Button Command="{Binding CloseOrderReviewModalCommand}" Style="{StaticResource GhostPillBtnStyle}" HorizontalAlignment="Right" Content="✕" />
                        </Grid>
                        <TextBlock Text="{Binding SelectedOrder.PoiName}" FontSize="12" Foreground="#66686B" Margin="0,4,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="满意度星级：" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Command="{Binding SetReviewStarsCommand}" CommandParameter="5" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,4,0" Content="5星超赞" />
                            <Button Command="{Binding SetReviewStarsCommand}" CommandParameter="4" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,4,0" Content="4星满意" />
                            <Button Command="{Binding SetReviewStarsCommand}" CommandParameter="3" Style="{StaticResource GhostPillBtnStyle}" Content="3星一般" />
                        </StackPanel>

                        <Border Background="#F4F5F7" CornerRadius="8" Padding="8,6" Margin="0,0,0,10">
                            <TextBox Text="{Binding ReviewCommentInput, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     FontSize="12" />
                        </Border>

                        <Button Command="{Binding SubmitOrderReviewCommand}"
                                Style="{StaticResource FlatActionBtnStyle}"
                                Padding="14,8"
                                FontSize="13"
                                Content="发布评价并同步至门店评论区" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- ========================================================================= -->
            <!-- M5: 美团通行证 1:1 原生全屏登录页 (com.meituan.passport.LoginActivity)     -->
            <!-- ========================================================================= -->
            <Grid Background="#FFFFFF" Visibility="{Binding IsLoginViewOpen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶部关闭栏与模拟短信验证码通知横幅 -->
                <StackPanel Grid.Row="0" Margin="14,10,14,0">
                    <!-- 模拟 Android 顶部短信通知条 (点击直接填入 6 位验证码, OBL-03) -->
                    <Button Command="{Binding FillSimulatedSmsCodeCommand}"
                            Cursor="Hand"
                            Background="#222426"
                            BorderThickness="0"
                            Padding="10,8"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasSimulatedSmsBanner, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SimulatedSmsBannerText}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#FFD100"
                                   TextWrapping="Wrap" />
                    </Button>

                    <Grid>
                        <Button Command="{Binding CloseLoginViewCommand}"
                                Style="{StaticResource GhostPillBtnStyle}"
                                HorizontalAlignment="Left"
                                Content="✕ 关闭" />
                        <TextBlock Text="美团通行证 · 安全登录"
                                   FontSize="12"
                                   Foreground="#999B9E"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="遇到问题"
                                   FontSize="12"
                                   Foreground="#66686B"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- 登录主体表单 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,12,22,20">
                    <StackPanel>
                        <!-- 美团袋鼠品牌头 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFD100" Margin="0,0,10,0">
                                <TextBlock Text="🦘" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="欢迎登录美团外卖" FontSize="20" FontWeight="Bold" Foreground="#222426" />
                                <TextBlock Text="未注册手机号验证后自动创建美团账号" FontSize="11.5" Foreground="#999B9E" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 三种登录模式切换 Tab (验证码 / 密码 / 扫码, OBL-04) -->
                        <Grid Margin="0,12,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding SwitchLoginModeCommand}" CommandParameter="Sms" Style="{StaticResource GhostPillBtnStyle}" Margin="0,0,4,0" FontWeight="Bold" Content="📱 验证码登录" />
                            <Button Grid.Column="1" Command="{Binding SwitchLoginModeCommand}" CommandParameter="Password" Style="{StaticResource GhostPillBtnStyle}" Margin="2,0,2,0" FontWeight="Bold" Content="🔒 密码登录" />
                            <Button Grid.Column="2" Command="{Binding SwitchLoginModeCommand}" CommandParameter="QrCode" Style="{StaticResource GhostPillBtnStyle}" Margin="4,0,0,0" FontWeight="Bold" Content="📷 扫码登录" />
                        </Grid>

                        <!-- 模式 1: 手机短信验证码登录 -->
                        <StackPanel Visibility="{Binding IsSmsLoginMode, Converter={StaticResource BoolToVis}}">
                            <Border Background="#F7F8FA" CornerRadius="12" Padding="12,10" Margin="0,0,0,10" BorderBrush="#E5E6EB" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="+86 ▾  |  " FontSize="14" FontWeight="Bold" Foreground="#222426" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding LoginPhoneInput, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="15"
                                             FontWeight="SemiBold"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Background="#F7F8FA" CornerRadius="12" Padding="12,8" Margin="0,0,0,12" BorderBrush="#E5E6EB" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="验证码  |  " FontSize="13.5" Foreground="#66686B" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding LoginSmsCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="15"
                                             FontWeight="Bold"
                                             VerticalContentAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Command="{Binding SendSmsCodeCommand}"
                                            Style="{StaticResource FlatActionBtnStyle}"
                                            Padding="10,5"
                                            FontSize="11.5"
                                            Content="{Binding SmsSendButtonText}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 模式 2: 账号密码登录 -->
                        <StackPanel Visibility="{Binding IsPasswordLoginMode, Converter={StaticResource BoolToVis}}">
                            <Border Background="#F7F8FA" CornerRadius="12" Padding="12,10" Margin="0,0,0,10" BorderBrush="#E5E6EB" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="账号/手机  |  " FontSize="13.5" Foreground="#66686B" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding LoginPhoneInput, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="14.5" />
                                </Grid>
                            </Border>
                            <Border Background="#F7F8FA" CornerRadius="12" Padding="12,10" Margin="0,0,0,12" BorderBrush="#E5E6EB" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="登录密码   |  " FontSize="13.5" Foreground="#66686B" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding LoginPasswordInput, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="14.5" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 模式 3: 美团 APP 扫码登录 -->
                        <Border Visibility="{Binding IsQrCodeLoginMode, Converter={StaticResource BoolToVis}}"
                                Background="#FFFDF5"
                                BorderBrush="#FFD100"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="116" Height="116" Background="#222426" CornerRadius="12" HorizontalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🔳 📷 🔳" FontSize="22" Foreground="#FFD100" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding QrCodeTokenText}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,4" />
                                        <TextBlock Text="🔳 🦘 🔳" FontSize="22" Foreground="#FFD100" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding QrCodeStatusText}" FontSize="11.5" Foreground="#66686B" Margin="0,8,0,8" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding RefreshQrCodeCommand}"
                                            Style="{StaticResource GhostPillBtnStyle}"
                                            Margin="0,0,6,0"
                                            Content="🔄 刷新二维码" />
                                    <Button Command="{Binding SimulateQrScanConfirmCommand}"
                                            Style="{StaticResource FlatActionBtnStyle}"
                                            Padding="10,4"
                                            FontSize="11"
                                            Content="📲 模拟手机扫码确认" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 隐私协议勾选框 (OBL-05) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <CheckBox IsChecked="{Binding IsPrivacyAccepted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock FontSize="11" Foreground="#66686B" TextWrapping="Wrap" Width="320">
                                <Run Text="我已阅读并同意" />
                                <Run Text="《美团用户协议》《隐私政策》" Foreground="#FF6B00" FontWeight="SemiBold" />
                                <Run Text="及《中国移动/联通/电信认证服务条款》" />
                            </TextBlock>
                        </StackPanel>

                        <!-- 美团黄大圆角登录按钮 -->
                        <Button Command="{Binding SubmitLoginCommand}"
                                Style="{StaticResource FlatActionBtnStyle}"
                                Padding="14,11"
                                FontSize="15"
                                Content="立即登录 / 验证并登录" />

                        <!-- 预设测试账号一键快切区 -->
                        <TextBlock Text="⚡ 快捷切换已绑定美团测试账号 (一键秒登)" FontSize="11.5" FontWeight="Bold" Foreground="#66686B" Margin="0,18,0,6" />
                        <ItemsControl ItemsSource="{Binding PresetUsers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.QuickSelectPresetUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource GhostPillBtnStyle}"
                                            HorizontalContentAlignment="Left"
                                            Padding="10,7"
                                            Margin="0,0,0,6">
                                        <Grid Width="335">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding AvatarEmoji}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Nickname}" FontSize="12" FontWeight="Bold" Foreground="#222426" />
                                                <TextBlock Text="{Binding VipBadgeText}" FontSize="10" Foreground="#FF6B00" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding MobileMasked}" FontSize="11" Foreground="#66686B" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 隐私协议未勾选拦截确认弹窗 (com.meituan.passport.dialogs.ConfirmDialog, OBL-05) -->
                <Border Grid.RowSpan="2"
                        Background="#88000000"
                        Visibility="{Binding IsPrivacyConfirmDialogOpen, Converter={StaticResource BoolToVis}}">
                    <Border Background="#FFFFFF" CornerRadius="16" Margin="28" Padding="18,16" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="服务协议及隐私政策提示" FontSize="15" FontWeight="Bold" Foreground="#222426" HorizontalAlignment="Center" />
                            <TextBlock Text="为了保障您的合法权益，请您阅读并同意《美团用户协议》《隐私政策》。点击“同意并继续登录”即代表您已阅读并同意上述全部协议。"
                                       FontSize="12"
                                       Foreground="#66686B"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding ClosePrivacyDialogCommand}"
                                        Style="{StaticResource GhostPillBtnStyle}"
                                        Margin="0,0,6,0"
                                        Padding="10,8"
                                        Content="不同意" />
                                <Button Grid.Column="1"
                                        Command="{Binding ConfirmPrivacyAndLoginCommand}"
                                        Style="{StaticResource FlatActionBtnStyle}"
                                        Margin="6,0,0,0"
                                        Padding="10,8"
                                        Content="同意并登录" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== Row 2: 底部实时状态轻量提示条 ==================== -->
        <Border Grid.Row="2" Background="#FFF9DC" BorderBrush="#F2E29B" BorderThickness="0,1,0,0" Padding="10,0">
            <TextBlock Text="{Binding StatusBannerText}"
                       FontSize="10"
                       Foreground="#6E5100"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- ==================== Row 3: 底部 5-Tab 原生导航栏 (58px) ==================== -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E6EB" BorderThickness="0,1,0,0" Padding="4,2">
            <ItemsControl ItemsSource="{Binding BottomTabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding BusinessId}"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid HorizontalAlignment="Center">
                                    <Border CornerRadius="13" Padding="10,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#FFD100" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="16" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="#222426"
                                           HorizontalAlignment="Center"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
