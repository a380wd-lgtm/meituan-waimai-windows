                                                    <TextBlock Text="{Binding Id}" FontSize="10" FontWeight="Bold" Foreground="#FF6B00" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10.5" Foreground="#333537" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
