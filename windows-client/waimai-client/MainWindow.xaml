                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingStackPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,12" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFDF7" BorderBrush="#F2D492" BorderThickness="1.5" CornerRadius="12" Padding="18,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="¥" FontSize="16" FontWeight="Bold" Foreground="#FF4A26" VerticalAlignment="Bottom" Margin="0,0,2,4" />
                                                <TextBlock Text="{Binding Amount, StringFormat={}{0:0.#}}" FontSize="34" FontWeight="ExtraBold" Foreground="#FF4A26" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Threshold, StringFormat=满 ¥{0:0} 可用}" FontSize="11.5" Foreground="#7A5C00" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#FF4A26" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding TagText}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="Bold" Foreground="#222426" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#66686C" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding ExpireTimeText}" FontSize="11" Foreground="#999B9F" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.InflateCouponCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MtOutlineButtonStyle}"
                                                    BorderBrush="#FF4A26"
                                                    Foreground="#FF4A26"
                                                    Padding="14,8"
                                                    Margin="0,0,10,0"
                                                    Content="立即膨胀"
                                                    FontWeight="Bold" />
                                            <Button Command="{Binding DataContext.ApplyCouponCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MtPillButtonStyle}"
                                                    Padding="16,8"
                                                    Content="去点餐使用" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ******************** TAB 10: 神抢手 · 限时大促爆品 ******************** -->
            <Border Visibility="{Binding IsFlashSaleTabActive, Converter={StaticResource BoolToVis}}"
                    Margin="16,12"
                    Background="#FFFFFF"
                    CornerRadius="14"
                    BorderBrush="{StaticResource MtCardBorderBrush}"
                    BorderThickness="1"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF4A26" CornerRadius="14" Padding="20,14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="⚡ 美团神抢手 · 大牌招牌菜限时 4 折起" FontSize="20" FontWeight="ExtraBold" Foreground="#FFFFFF" />
                            <TextBlock Text="对齐底部凸起大促 Tab (BusinessId = 10) · 点击「立即抢购」自动直达门店并加购至购物车口袋" FontSize="12.5" Foreground="#FFE5DF" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding FlashDeals}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFDFB" BorderBrush="#FFD8CE" BorderThickness="1.5" CornerRadius="12" Padding="16" Margin="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#FF4A26" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding DiscountBadge}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="{Binding PoiName}" FontSize="12" FontWeight="SemiBold" Foreground="#66686C" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="ExtraBold" Foreground="#222426" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12">
                                            <TextBlock Text="{Binding StockTip}" FontSize="11.5" Foreground="#FF6600" FontWeight="SemiBold" />
                                            <ProgressBar Value="{Binding SoldPercent}" Maximum="100" Height="8" Foreground="#FF4A26" Background="#FFE6E0" Margin="0,6,0,0" />
                                        </StackPanel>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="¥" FontSize="13" FontWeight="Bold" Foreground="#FF4A26" VerticalAlignment="Bottom" Margin="0,0,1,2" />
                                                <TextBlock Text="{Binding FlashPrice, StringFormat={}{0:0.0}}" FontSize="22" FontWeight="ExtraBold" Foreground="#FF4A26" />
                                                <TextBlock Text="{Binding OriginPrice, StringFormat=¥{0:0.0}}" FontSize="11.5" Foreground="#999B9F" TextDecorations="Strikethrough" VerticalAlignment="Bottom" Margin="6,0,0,3" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.ApplyFlashDealCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MtPillButtonStyle}"
                                                    Background="#FF4A26"
                                                    Foreground="#FFFFFF"
                                                    Padding="14,7"
                                                    Content="立即抢购 ⚡" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- ******************** TAB 2: 订单中心 · 骑手实时地图轨迹 + 骑手/商家三方 IM 群聊 ******************** -->
            <Grid Visibility="{Binding IsOrderTabActive, Converter={StaticResource BoolToVis}}" Margin="16,12">
                <Grid.ColumnDefinitions>
                    <!-- 左栏：全部订单列表 (OrderListResponse.digestlist) -->
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="14" />
                    <!-- 右栏：骑手实时地图轨迹 + 骑手/商家三方 IM 群聊 -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：订单列表 -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="{StaticResource MtCardBorderBrush}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="📋 全部订单 (OrderListResponse)" FontSize="16" FontWeight="ExtraBold" Foreground="#222426" />
                            <TextBlock Text="对齐 OrderListResponse.fromJson (digestlist / uncomment_count / refund_count)" FontSize="11" Foreground="#66686C" Margin="0,2,0,0" />
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Orders}"
                                 SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="OrdBd" Background="#FAFAFC" BorderBrush="#E6E8EC" BorderThickness="1.5" CornerRadius="12" Padding="12" Cursor="Hand">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="OrdBd" Property="Background" Value="#FFFDF4" />
                                                        <Setter TargetName="OrdBd" Property="BorderBrush" Value="#FFB800" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PoiName}" FontSize="14.5" FontWeight="Bold" Foreground="#222426" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Background="#FFF4E5" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding StatusDescription}" FontSize="11" FontWeight="Bold" Foreground="#D46B08" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding FoodNames}" FontSize="12" Foreground="#55575B" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FormatOrderTime}" FontSize="11" Foreground="#888A8E" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="实付 " FontSize="11.5" Foreground="#66686C" VerticalAlignment="Bottom" />
                                                <TextBlock Text="{Binding Total, StringFormat=¥{0:0.00}}" FontSize="15" FontWeight="ExtraBold" Foreground="#222426" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 右栏：骑手实时地图轨迹 + 骑手/商家三方 IM 群聊 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <!-- 上半部分：骑手 GPS 实时轨迹雷达面板 -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <!-- 下半部分：订单详情与骑手/商家三方 IM 群聊 -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 骑手实时地图轨迹卡片 -->
                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="{StaticResource MtCardBorderBrush}" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 顶部状态与推进模拟按钮 -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#FFD100" CornerRadius="5" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="🛵 美团专送实时轨迹" FontSize="11" FontWeight="Bold" Foreground="#222426" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedOrder.StatusDescription}" FontSize="16" FontWeight="ExtraBold" Foreground="#222426" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedOrder.ArrivalTimeText}" FontSize="12" Foreground="#00B578" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding AdvanceRiderStepCommand}"
                                        Style="{StaticResource MtOutlineButtonStyle}"
                                        Background="#FFF9E6"
                                        BorderBrush="#FFC300"
                                        Padding="12,6"
                                        Content="⚡ 模拟推进骑手位置"
                                        FontSize="12"
                                        FontWeight="Bold" />
                            </Grid>

                            <!-- 可视化地图路径条 -->
                            <Border Grid.Row="1" Background="#EEF4F8" BorderBrush="#D5E3EC" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SelectedOrder.PoiName, StringFormat=🏪 商家：{0}}" FontSize="12" FontWeight="Bold" Foreground="#222426" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedOrderCoordinatesText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0066CC" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding SelectedOrder.RecipientAddress, StringFormat=🏠 送至：{0}}" FontSize="12" FontWeight="Bold" Foreground="#222426" />
                                    </Grid>
                                    <ProgressBar Value="{Binding SelectedOrderProgressPercent, Mode=OneWay}" Maximum="100" Height="10" Foreground="#FFD100" Background="#D8E2EB" Margin="0,8,0,4" />
                                    <TextBlock Text="{Binding SelectedOrder.RiderName, StringFormat=当前接单骑手：{0}（保温箱温度 62.5℃ · 已开启准时宝延误必赔）}" FontSize="11" Foreground="#55575B" />
                                </StackPanel>
                            </Border>

                            <!-- 5 步配送节点时间轴 -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding SelectedOrder.TrackingSteps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFAFC" BorderBrush="#EAECEF" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="#00B578" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Bold" Foreground="#222426" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#7A7C80" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- 下半部分：餐品账单明细 + 骑手/商家三方群聊 IM -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 订单餐品与账单明细 -->
                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="{StaticResource MtCardBorderBrush}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🧾 订单餐品与费用明细" FontSize="14.5" FontWeight="Bold" Foreground="#222426" />
                                <TextBlock Text="{Binding SelectedOrder.HashId, StringFormat=订单编号：{0}}" FontSize="11" Foreground="#888A8E" Margin="0,3,0,8" />
                                <ItemsControl ItemsSource="{Binding SelectedOrder.FoodItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FoodName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#222426" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SpecText}" FontSize="10.5" Foreground="#888A8E" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat=x{0}}" FontSize="12" Foreground="#66686C" Margin="8,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat=¥{0:0.00}}" FontSize="12.5" FontWeight="Bold" Foreground="#222426" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="#EAECEF" Margin="0,8" />
                                <TextBlock Text="{Binding SelectedOrder.BoxFeeTotal, StringFormat=打包费合计：¥{0:0.00}}" FontSize="11.5" Foreground="#66686C" />
                                <TextBlock Text="{Binding SelectedOrder.ShippingFee, StringFormat=配送费：¥{0:0.00}}" FontSize="11.5" Foreground="#66686C" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding SelectedOrder.DiscountTotal, StringFormat=神券与满减共省：-¥{0:0.00}}" FontSize="11.5" Foreground="#FF4A26" FontWeight="Bold" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding SelectedOrder.Total, StringFormat=实付合计：¥{0:0.00}}" FontSize="15" FontWeight="ExtraBold" Foreground="#222426" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 骑手/商家/顾客 三方实时群聊 IM 面板 -->
                        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="{StaticResource MtCardBorderBrush}" BorderThickness="1" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="💬 骑手 · 商家 · 顾客 三方实时沟通群 (美团大象 IM 契约)" FontSize="14" FontWeight="Bold" Foreground="#222426" />
                                </StackPanel>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding SelectedOrder.ImMessages}"
                                         BorderThickness="1"
                                         BorderBrush="#F0F1F4"
                                         Background="#F8F9FB"
                                         Padding="10"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         VirtualizingStackPanel.ScrollUnit="Pixel">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="Focusable" Value="False" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" BorderBrush="#E4E7ED" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#FFD100" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding SenderRole}" FontSize="10" FontWeight="Bold" Foreground="#222426" />
                                                        </Border>
                                                        <TextBlock Text="{Binding SenderName}" FontSize="11.5" FontWeight="Bold" Foreground="#222426" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="#999B9F" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Content}" FontSize="12.5" Foreground="#333538" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 智能快捷回复芯片 -->
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding SelectedOrder.SmartReplySuggestions}" Margin="0,8,0,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SendSmartReplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MtOutlineButtonStyle}"
                                                    Padding="8,3"
                                                    Margin="0,0,6,4"
                                                    Content="{Binding}"
                                                    FontSize="11" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 消息发送栏 -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ImDraftText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="34"
                                             VerticalContentAlignment="Center"
                                             Padding="10,0"
                                             FontSize="12.5"
                                             BorderBrush="#DCDFE6"
                                             Margin="0,0,8,0" />
                                    <Button Grid.Column="1"
                                            Command="{Binding SendImMessageCommand}"
                                            Style="{StaticResource MtPillButtonStyle}"
                                            Padding="18,6"
                                            Content="发送消息"
                                            FontSize="12.5" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ******************** TAB 3: 我的美团 · 个人中心 + 地址簿 + REA 逆向契约自检台 ******************** -->
            <Grid Visibility="{Binding IsMineTabActive, Converter={StaticResource BoolToVis}}" Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：个人信息资产卡片 (MineMPFragment) + 收货地址簿 -->
                <StackPanel Grid.Column="0">
                    <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="{StaticResource MtCardBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="54" Height="54" CornerRadius="27" Background="#FFD100" Margin="0,0,14,0">
                                    <TextBlock Text="🤠" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MineProfile.Nickname}" FontSize="17" FontWeight="ExtraBold" Foreground="#222426" />
                                        <Border Background="#222426" CornerRadius="5" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding MineProfile.VipLevelText}" FontSize="10.5" FontWeight="Bold" Foreground="#FFD100" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MineProfile.PhoneMasked, StringFormat=绑定手机：{0} · MineMPFragment (Mach Pro)}" FontSize="11.5" Foreground="#66686C" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <UniformGrid Columns="3" Margin="0,16,0,0">
                                <Border Background="#FFFDF5" CornerRadius="10" Padding="10" Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Coupons.Count}" FontSize="20" FontWeight="ExtraBold" Foreground="#FF4A26" HorizontalAlignment="Center" />
                                        <TextBlock Text="可用神券(张)" FontSize="11" Foreground="#66686C" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFDF5" CornerRadius="10" Padding="10" Margin="3,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding MineProfile.RedPacketBalance, StringFormat=¥{0:0.00}}" FontSize="20" FontWeight="ExtraBold" Foreground="#FF4A26" HorizontalAlignment="Center" />
                                        <TextBlock Text="红包津贴" FontSize="11" Foreground="#66686C" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFFDF5" CornerRadius="10" Padding="10" Margin="6,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding MineProfile.MonthlySavedAmount, StringFormat=¥{0:0.0}}" FontSize="20" FontWeight="ExtraBold" Foreground="#00B578" HorizontalAlignment="Center" />
                                        <TextBlock Text="本月累计已省" FontSize="11" Foreground="#66686C" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 收货地址管理 -->
                    <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="{StaticResource MtCardBorderBrush}" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📍 我的收货地址簿 (WmAddress)" FontSize="15" FontWeight="Bold" Foreground="#222426" />
                                <Button Grid.Column="1" Command="{Binding CycleAddressCommand}" Style="{StaticResource MtOutlineButtonStyle}" Padding="10,4" Content="切换默认地址" FontSize="11.5" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Addresses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFAFC" BorderBrush="#E6E8EC" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#FFD100" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding TagLabel}" FontSize="10" FontWeight="Bold" Foreground="#222426" />
                                                    </Border>
                                                    <TextBlock Text="{Binding AddressDetail}" FontSize="13" FontWeight="Bold" Foreground="#222426" />
                                                    <TextBlock Text="{Binding HouseNumber}" FontSize="12.5" Foreground="#55575B" Margin="6,0,0,0" />
                                                </StackPanel>
                                                <TextBlock FontSize="11.5" Foreground="#66686C" Margin="0,4,0,0">
                                                    <Run Text="{Binding ContactName}" />
                                                    <Run Text=" (" />
                                                    <Run Text="{Binding GenderText}" />
                                                    <Run Text=")  " />
                                                    <Run Text="{Binding Phone}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右栏：REA 逆向工程证据链与双 AI 15+ 项契约自检报告 -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="{StaticResource MtCardBorderBrush}" BorderThickness="1" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🔬 REA 逆向工程证据链 &amp; 自动化契约自检中心" FontSize="16.5" FontWeight="ExtraBold" Foreground="#222426" />
                                <TextBlock Text="{Binding PackageIdentityText}" FontSize="11.5" Foreground="#66686C" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding RunSelfTestCommand}"
                                    Style="{StaticResource MtPillButtonStyle}"
                                    Padding="16,7"
                                    Content="🔄 重新执行全量契约自检"
                                    FontSize="12" />
                        </Grid>

                        <Border Grid.Row="1" Background="#F0FAF5" BorderBrush="#9EE2C0" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,10">
                            <TextBlock Text="{Binding SelfTestSummaryText}" FontSize="13" FontWeight="Bold" Foreground="#00875A" />
                        </Border>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding SelfTestItems}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAFAFC" BorderBrush="#E6E8EC" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#00B578" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Id}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11.5" FontWeight="Bold" Foreground="#222426" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="#222426" />
                                                <TextBlock Text="{Binding EvidenceDetail}" FontSize="11" Foreground="#66686C" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 模态弹窗 1: 多规格 SKU 与属性选择器 ==================== -->
            <Border Visibility="{Binding IsSpecModalOpen, Converter={StaticResource BoolToVis}}"
                    Background="#77000000">
                <Border Width="480"
                        Background="#FFFFFF"
                        CornerRadius="16"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SpecModalFood.Name}" FontSize="18" FontWeight="ExtraBold" Foreground="#222426" />
                            <Button Grid.Column="1" Command="{Binding CloseSpecModalCommand}" Style="{StaticResource MtOutlineButtonStyle}" Padding="8,2" Content="✕" />
                        </Grid>
                        <TextBlock Text="选择规格 (GoodsSku)：" FontSize="12.5" FontWeight="Bold" Foreground="#66686C" Margin="0,14,0,6" />
                        <ItemsControl ItemsSource="{Binding SpecModalFood.Skus}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectSpecSkuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MtOutlineButtonStyle}"
                                            Padding="12,6"
                                            Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SpecName}" FontSize="12.5" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Price, StringFormat= (¥{0:0.0})}" FontSize="12" Foreground="#FF4A26" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="口味属性偏好 (点击切换选项)：" FontSize="12.5" FontWeight="Bold" Foreground="#66686C" Margin="0,8,0,6" />
                        <ItemsControl ItemsSource="{Binding SpecModalFood.AttrGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding GroupName}" FontSize="12.5" Foreground="#55575B" VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Command="{Binding DataContext.CycleAttrOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MtOutlineButtonStyle}"
                                                Background="#FFF9E6"
                                                BorderBrush="#FFC300"
                                                HorizontalAlignment="Left"
                                                Padding="14,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SelectedOption}" FontSize="12.5" FontWeight="Bold" Foreground="#222426" />
                                                <TextBlock Text=" (点击切换 ↻)" FontSize="11" Foreground="#888A8E" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#FFFDF5" BorderBrush="#F2DF9B" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,10,0,14">
                            <TextBlock Text="{Binding SpecModalPreviewText}" FontSize="12.5" FontWeight="Bold" Foreground="#222426" />
                        </Border>

                        <Button Command="{Binding ConfirmSpecModalCommand}"
                                Style="{StaticResource MtPillButtonStyle}"
                                Padding="0,10"
                                HorizontalAlignment="Stretch"
                                Content="＋ 确认加入购物车口袋"
                                FontSize="14" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- ==================== 模态弹窗 2: 购物车多口袋抽屉明细 ==================== -->
            <Border Visibility="{Binding IsCartDrawerOpen, Converter={StaticResource BoolToVis}}"
                    Background="#66000000">
                <Border Width="540"
                        MaxHeight="520"
                        Background="#FFFFFF"
                        CornerRadius="16"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🛍️ 多口袋购物车明细 (ShopCartItem)" FontSize="16.5" FontWeight="ExtraBold" Foreground="#222426" />
                            <Button Grid.Column="1" Command="{Binding ClearCartCommand}" Style="{StaticResource MtOutlineButtonStyle}" Padding="10,4" Margin="0,0,8,0" Content="清空口袋" FontSize="11.5" />
                            <Button Grid.Column="2" Command="{Binding ToggleCartDrawerCommand}" Style="{StaticResource MtOutlineButtonStyle}" Padding="8,4" Content="✕" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ActiveCartItems}"
                                 BorderThickness="1"
                                 BorderBrush="#EAECEF"
                                 Background="#FAFAFC"
                                 Padding="10"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FFD100" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PocketId, StringFormat={}{0}号口袋}" FontSize="10.5" FontWeight="Bold" Foreground="#222426" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FoodName}" FontSize="13" FontWeight="Bold" Foreground="#222426" />
                                            <TextBlock Text="{Binding SpecSummary}" FontSize="11" Foreground="#7A7C80" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat=x{0}}" FontSize="13" FontWeight="Bold" Foreground="#222426" VerticalAlignment="Center" Margin="12,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat=¥{0:0.00}}" FontSize="14" FontWeight="ExtraBold" Foreground="#FF4A26" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CartPrice.PreviewSubTip}" FontSize="12" Foreground="#00875A" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding CheckoutOrderCommand}" Style="{StaticResource MtPillButtonStyle}" Padding="20,8" Content="立即去结算" FontSize="13.5" />
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- ==================== 模态弹窗 3: 小美 DeepEat AI 智能助餐对话面板 ==================== -->
            <Border Visibility="{Binding IsDeepEatDrawerOpen, Converter={StaticResource BoolToVis}}"
                    Background="#66000000">
                <Border Width="560"
                        Background="#FFFFFF"
                        CornerRadius="16"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✨ 小美 DeepEat AI 智能点餐助手 (v8.84.2 新特性)" FontSize="17" FontWeight="ExtraBold" Foreground="#222426" />
                            <Button Grid.Column="1" Command="{Binding ToggleDeepEatDrawerCommand}" Style="{StaticResource MtOutlineButtonStyle}" Padding="8,2" Content="✕" />
                        </Grid>
                        <TextBlock Text="输入您的用餐场景、口味或预算，小美 AI 将结合附近门店评分、神券膨胀与满减为您定制最优套餐：" FontSize="12" Foreground="#66686C" Margin="0,6,0,10" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding DeepEatQueryText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0"
                                     FontSize="12.5"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1" Command="{Binding AskDeepEatAiCommand}" Style="{StaticResource MtPillButtonStyle}" Padding="16,6" Content="AI 定制推荐" />
                        </Grid>
                        <Border Background="#FFFDF5" BorderBrush="#F2DF9B" BorderThickness="1.5" CornerRadius="10" Padding="14">
                            <TextBlock Text="{Binding DeepEatResponseText}" FontSize="12.5" Foreground="#222426" TextWrapping="Wrap" LineHeight="20" />
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ==================== 3. 底部 5 大动态导航栏 (MainActivity Dynamic Bottom Bar) ==================== -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="24,0">
            <ItemsControl ItemsSource="{Binding BottomTabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding BusinessId}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="15" FontWeight="Bold" Foreground="#FF6600" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="ExtraBold" Foreground="#222426" VerticalAlignment="Center" />
                                        <Border Background="#FF4A26" CornerRadius="6" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BubbleTagText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BubbleTagText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding BubbleTagText}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#7A7C80" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ==================== 4. 底部逆向契约遥测状态条 ==================== -->
        <Border Grid.Row="3" Background="#222426" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusBannerText}" FontSize="11.5" Foreground="#FFD100" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding SelfTestSummaryText}" FontSize="11" Foreground="#7FE3B9" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
