                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding MineProfile.ShenQuanCount, StringFormat='{}{0}张'}" FontSize="14" FontWeight="Bold" Foreground="#FF6B00" HorizontalAlignment="Center" />
                                            <TextBlock Text="可用神券" FontSize="10.5" Foreground="#66686B" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding MineProfile.TuanBiPoints}" FontSize="14" FontWeight="Bold" Foreground="#222426" HorizontalAlignment="Center" />
